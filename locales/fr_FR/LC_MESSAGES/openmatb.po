msgstr "Le scénario contient des erreurs. Voir le fichier suivant : %s."

#: core/scenario.py:48
#, python-format
msgid "%s was not found"
msgstr "%s n'est pas disponible"

#: core/scenario.py:76
#, python-format
msgid "Scenario error: %(plugin)s is not a valid plugin name (l. %(line)s)"
msgstr "Erreur du scénario : %(plugin)s n'est pas un nom de plugin valide (l. %(line)s)"

#: core/scenario.py:121
#, python-format
msgid "Line %(line)s: '%(event)s' is deprecated and will be ignored"
msgstr "Ligne %(line)s : '%(event)s' est obsolète et sera ignoré"

#: core/scenario.py:171
#, python-format
msgid "The (%s) plugin does not have a start command."
msgstr "Le plugin (%s) n'a pas de commande start."

#: core/scenario.py:226
#, python-format
msgid "Error on line %s. This event does not trigger any command."
msgstr "Erreur à la ligne %s. Cet évènement n'est associé à aucune commande."

#: core/scenario.py:60
#, python-format
msgid "Scenario error: line %(line)s is not formatted as H:MM:SS;plugin;command (%(text)s)"
msgstr "Erreur de scénario : la ligne %(line)s n'est pas au format H:MM:SS;plugin;commande (%(text)s)"

#: core/scenario.py:203 core/scenario.py:219
#, python-format
msgid "Error on line %(line)s. Invalid system command: %(command)s"
msgstr "Erreur à la ligne %(line)s. Commande système invalide : %(command)s"

#: core/scenario.py:230
#, python-format
msgid "Error on line %s. Maximum length of an event is 2 (parameter;value)."
msgstr "Erreur à la ligne %s. Un évènement ne peut avoir plus de deux arguments (paramètre;valeur)."

#: core/scenario.py:178
#, python-format
msgid "The (%s) plugin does not have a stop command."
msgstr "Le plugin (%s) n'a pas de commande stop."

#: core/scenario.py:207
#, python-format
msgid "Error on line %s. Agent command requires a name argument"
msgstr "Erreur à la ligne %s. La commande agent nécessite un argument de nom"

#: core/scenario.py:194
#, python-format
msgid "The (%s) plugin has a start command without a preceding filename command."
msgstr "Le plugin (%s) a une commande start sans commande filename la précédant."

#: core/scenario.py:211
#, python-format
msgid "Error on line %(line)s. Unknown agent: %(agent)s"
msgstr "Erreur à la ligne %(line)s. Agent inconnu : %(agent)s"

#: core/scenario.py:237
#, python-format
msgid "Error on line %(line)s. Method (%(method)s) is not available for the plugin (%(plugin)s)"
msgstr "Erreur à la ligne %(line)s. La méthode (%(method)s) n'est pas disponible pour ce plugin (%(plugin)s)"

#: core/scenario.py:216
#, python-format
msgid "Error on line %s. mousecontrol command requires True/False argument"
msgstr "Erreur à la ligne %s. La commande mousecontrol nécessite un argument True/False"

#: core/scenario.py:288
#, python-format
msgid "Error on line %(line)s. The %(plugin)s plugin does not have a %(parameter)s parameter"
msgstr "Erreur à la ligne %(line)s. Le plugin %(plugin)s ne comporte pas de paramètre %(parameter)s"

#: core/scenario.py:258
#, python-format
msgid "Warning on line %(line)s. Parameter (%(parameter)s) has no verification method"
msgstr "Avertissement à la ligne %(line)s. Le paramètre (%(parameter)s) n'a pas de méthode de vérification"

#: core/scenario.py:277
#, python-format
msgid "Error on line %(line)s. %(parameter)s "
msgstr "Erreur à la ligne %(line)s. %(parameter)s "

