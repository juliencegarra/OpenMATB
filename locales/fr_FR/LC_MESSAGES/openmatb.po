#: core/utils.py:113
msgid "In config.ini, [%s] parameter must be a boolean (true or false, not %s). Defaulting to False"
msgstr "Dans config.ini, le paramètre [%s] doit être un bolléen (true ou false, non pas %s). Défaut = False"

#: core/utils.py:123
msgid "In config.ini, [%s] parameter must be an integer (not %s)"
msgstr "Dans config.ini, le paramètre [%s] doit être un entier (et non %s)"

#: core/utils.py:132
msgid "In config.ini, [%s] parameter must be a float (not %s)"
msgstr "Dans config.ini, le paramètre [%s] doit être un flottant (et non %s)"

#: core/utils.py:142
msgid "In config.ini, [%s] parameter must be a list of floats (not %s)"
msgstr "Dans config.ini, le paramètre [%s] doit être une liste de flottants (et non %s)"

#: core/utils.py:154
msgid "In config.ini, the specified font is not available. A default font will be used."
msgstr "Dans config.ini, la police spécifiée n'est pas disponible. Une police par défaut sera utilisée."

#: core/validation.py:35
msgid "should be a natural (0 included) integer (not %s)."
msgstr "devrait être un entier naturel (0 inclus, et non %s)."

#: core/validation.py:97
msgid "should be a positive float (not %s)"
msgstr "devrait être un nombre décimal positif (et non %s)."

#: core/validation.py:216
msgid "should be a float between 0 and 1 (included) (not %s)"
msgstr "devrait être un nombre décimal compris entre 0 et 1 inclus (et non %s)"

#: core/validation.py:167 core/validation.py:163
msgid "should be an acceptable joystick key value (not %s). See documentation."
msgstr "devrait être une touche de joystick acceptable (et non %s). Voir la documentation."

#: core/validation.py:179
msgid "should be an acceptable (keyboard or joystick) key value (not %s). See documentation."
msgstr "devrait être une touche (clavier ou joystick) acceptable (et non %s). Voir la documentation."

#: core/validation.py:31
msgid "should be a string (not %s)."
msgstr "devrait être une chaîne de caractères (et non %s)."

#: core/validation.py:52
msgid "should be a positive (0 excluded) integer (not %s)."
msgstr "devrait être un entier positif (0 exclus, et non %s)."

#: core/validation.py:130
msgid "should be comprised in %s (not %s)"
msgstr "devrait être compris dans %s (et non %s)"

#: core/validation.py:147
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "devrait être une touche de clavier acceptable (et non %s). Voir la documentation."

#: core/validation.py:197
msgid "should be composed of letters [a-z] or digits [0-9] (not %s in %s)"
msgstr "devrait n'être composé que de lettres [a-z] et de chiffres [0-9] (et non %s dans %s)"

#: core/validation.py:212
msgid "should be composed of valid callsigns (not %s)"
msgstr "devrait être composé d'identifiants valides (et non %s)"

#: core/validation.py:235
msgid "should be available either in the Instruction or Questionnaire folder (not %s)"
msgstr "devrait être disponible dans le dossier Instruction ou Questionnaire (%s)"

#: core/validation.py:61
msgid "should be a boolean (not %s)."
msgstr "devrait être un booléen (et non %s)."

#: core/validation.py:137
msgid "should be a valid regex expression (not %s)"
msgstr "devrait être une expression régulière (regex) valide (et non %s)"

#: core/validation.py:78
msgid "must be a color name (%s), (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %s)"
msgstr "devrait être un nom de couleur (%s), une valeur (R,G,B,a) ou hexadécimale (p.ex., #00ff00) (non pas %s)."

#: core/validation.py:92
msgid "should be (R,G,B,a) values each comprised between 0 and 255 (not %s)"
msgstr "devraient être des valeurs (R,G,B,a) comprises en 0 et 255 (et non %s)"

