#, python-format
msgid "should be comprised in %(accepted)s (not %(value)s)"
msgstr "devrait être compris dans %(accepted)s (et non %(value)s)"

#: core/validation.py:149
#, python-format
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "devrait être une touche de clavier acceptable (et non %s). Voir la documentation."

#: core/validation.py:199
#, python-format
msgid "should be composed of letters [a-z] or digits [0-9] (not %(characters)s in %(value)s)"
msgstr "devrait n'être composé que de lettres [a-z] et de chiffres [0-9] (et non %(characters)s dans %(value)s)"

