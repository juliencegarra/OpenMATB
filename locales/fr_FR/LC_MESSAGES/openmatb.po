msgstr "La librairie pylsl de python est manquante. Aucun marqueur ne sera envoyé"

#: plugins/parallelport.py:19
msgid "Parallel port"
msgstr "Port parallèle"

#: plugins/parallelport.py:52
msgid "Parallel port is not supported on macOS. Skipping parallel plugin."
msgstr "Le port parallèle n'est pas supporté sur macOS. Plugin ignoré."

#: plugins/parallelport.py:41
msgid "The parallel port is not available in the browser: set web_serial_trigger=True in config.ini to use a USB trigger box. Skipping parallel plugin"
msgstr "Le port parallèle n'est pas disponible dans le navigateur : indiquez web_serial_trigger=True dans config.ini pour utiliser un boîtier de triggers USB. Plugin ignoré"

#: plugins/parallelport.py:61
msgid "Python Parallel module is missing. On Windows, install pyparallel (pip install pyparallel) and the InpOut32 driver (provides simpleio.dll)."
msgstr "La librairie Python Parallel est manquante. Sous Windows, installez pyparallel (pip install pyparallel) et le pilote InpOut32 (fournit simpleio.dll)."

#: plugins/parallelport.py:69
msgid "Python Parallel module is missing. On Linux, install pyparallel (pip install pyparallel) and ensure the ppdev kernel module is loaded."
msgstr "La librairie Python Parallel est manquante. Sous Linux, installez pyparallel (pip install pyparallel) et assurez-vous que le module noyau ppdev est chargé."

#: plugins/parallelport.py:83
msgid "Parallel port not found. Ensure the InpOut32 driver is installed (provides simpleio.dll) and that a physical parallel port is available."
msgstr "Port parallèle non trouvé. Vérifiez que le pilote InpOut32 est installé (fournit simpleio.dll) et qu'un port parallèle physique est disponible."

#: plugins/parallelport.py:91
msgid "Parallel port not found. Ensure /dev/parport0 exists and you have read/write permissions (try: sudo chmod 666 /dev/parport0)."
msgstr "Port parallèle non trouvé. Vérifiez que /dev/parport0 existe et que vous avez les droits de lecture/écriture (essayez : sudo chmod 666 /dev/parport0)."

#: plugins/parallelport.py:99
msgid "Parallel port error: {error}"
msgstr "Erreur du port parallèle : {error}"

