#, python-format
msgid "The (%s) plugin has a start command without a preceding filename command."
msgstr "プラグイン (%s) の start コマンドの前に filename コマンドがありません。"

#: core/scenario.py:211
#, python-format
msgid "Error on line %(line)s. Unknown agent: %(agent)s"
msgstr "%(line)s 行目でエラー。不明なエージェント：%(agent)s"

#: core/scenario.py:237
#, python-format
msgid "Error on line %(line)s. Method (%(method)s) is not available for the plugin (%(plugin)s)"
msgstr "%(line)s 行目でエラー。メソッド (%(method)s) はプラグイン (%(plugin)s) では使用できません"

#: core/scenario.py:216
#, python-format
msgid "Error on line %s. mousecontrol command requires True/False argument"
msgstr "%s 行目でエラー。mousecontrol コマンドには True/False の引数が必要です"

