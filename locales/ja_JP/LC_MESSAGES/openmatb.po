#: web/texts.json:49
msgid "The server does not send the .wasm files as application/wasm (Moodle: Site administration > Server > File types)."
msgstr "サーバーが .wasm ファイルを application/wasm として送信していません（Moodle：サイト管理 > サーバー > ファイルタイプ）。"

#: web/texts.json:50
msgid "Trigger box (parallelport plugin)"
msgstr "トリガーボックス（parallelport プラグイン）"

#: web/texts.json:51
msgid "No port chosen."
msgstr "ポートが選択されていません。"

#: web/texts.json:52
msgid "Choose the port"
msgstr "ポートを選択"

#: web/texts.json:53
msgid "web_serial_trigger: this browser cannot use serial ports (use Chrome or Edge)"
msgstr "web_serial_trigger：このブラウザではシリアルポートを使用できません（Chrome または Edge を使用してください）"

