msgstr "%s が見つかりません"

#: core/scenario.py:76
msgid "Scenario error: %s is not a valid plugin name (l. %s)"
msgstr "シナリオエラー：%s は有効なプラグイン名ではありません（%s 行目）"

#: core/scenario.py:118
msgid "Line %s: '%s' is deprecated and will be ignored"
msgstr "%s 行目：'%s' は非推奨のため無視されます"

#: core/scenario.py:166
msgid "The (%s) plugin does not have a start command."
msgstr "プラグイン (%s) に start コマンドがありません。"

#: core/scenario.py:213
msgid "Error on line %s. This event does not trigger any command."
msgstr "%s 行目でエラー。このイベントはどのコマンドも実行しません。"

#: core/scenario.py:60
msgid "Scenario error: line %s is not formatted as H:MM:SS;plugin;command (%s)"
msgstr "シナリオエラー：%s 行目が H:MM:SS;プラグイン;コマンド の形式ではありません (%s)"

#: core/scenario.py:197 core/scenario.py:208
msgid "Error on line %s. Invalid system command: %s"
msgstr "%s 行目でエラー。無効なシステムコマンド：%s"

#: core/scenario.py:217
msgid "Error on line %s. Maximum length of an event is 2 (parameter;value)."
msgstr "%s 行目でエラー。イベントの要素は最大 2 つです（パラメータ;値）。"

#: core/scenario.py:173
msgid "The (%s) plugin does not have a stop command."
msgstr "プラグイン (%s) に stop コマンドがありません。"

#: core/scenario.py:199
msgid "Error on line %s. Agent command requires a name argument"
msgstr "%s 行目でエラー。agent コマンドには名前の引数が必要です"

#: core/scenario.py:189
msgid "The (%s) plugin has a start command without a preceding filename command."
msgstr "プラグイン (%s) の start コマンドの前に filename コマンドがありません。"

#: core/scenario.py:202
msgid "Error on line %s. Unknown agent: %s"
msgstr "%s 行目でエラー。不明なエージェント：%s"

#: core/scenario.py:224
msgid "Error on line %s. Method (%s) is not available for the plugin (%s)"
msgstr "%s 行目でエラー。メソッド (%s) はプラグイン (%s) では使用できません"

#: core/scenario.py:206
msgid "Error on line %s. mousecontrol command requires True/False argument"
msgstr "%s 行目でエラー。mousecontrol コマンドには True/False の引数が必要です"

#: core/scenario.py:271
msgid "Error on line %s. The %s plugin does not have a %s parameter"
msgstr "%s 行目でエラー。%s プラグインに %s パラメータはありません"

#: core/scenario.py:245
msgid "Warning on line %s. Parameter (%s) has no verification method"
msgstr "%s 行目で警告。パラメータ (%s) に検証方法がありません"

#: core/scenario.py:263
msgid "Error on line %s. %s "
msgstr "%s 行目でエラー。%s "

