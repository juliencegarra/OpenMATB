msgstr "Fehler in Zeile %s. Dieses Ereignis löst keinen Befehl aus."

#: core/scenario.py:60
msgid "Scenario error: line %s is not formatted as H:MM:SS;plugin;command (%s)"
msgstr "Szenariofehler: Zeile %s hat nicht das Format H:MM:SS;Plugin;Befehl (%s)"

#: core/scenario.py:197 core/scenario.py:208
