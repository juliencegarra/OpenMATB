#, python-format
msgid "must be a color name (%(colors)s), (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %(value)s)"
msgstr "muss ein Farbname (%(colors)s), ein (R,G,B,a)- oder Hexadezimalwert sein (z. B. #00ff00) (nicht %(value)s)"

