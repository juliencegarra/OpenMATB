#: core/scenario.py:76
#, python-format
msgid "Scenario error: %(plugin)s is not a valid plugin name (l. %(line)s)"
msgstr "Szenariofehler: %(plugin)s ist kein gültiger Plugin-Name (Z. %(line)s)"

#: core/scenario.py:121
#, python-format
msgid "Line %(line)s: '%(event)s' is deprecated and will be ignored"
msgstr "Zeile %(line)s: '%(event)s' ist veraltet und wird ignoriert"

#: core/scenario.py:171
#, python-format
msgid "The (%s) plugin does not have a start command."
msgstr "Das Plugin (%s) hat keinen start-Befehl."

#: core/scenario.py:226
#, python-format
msgid "Error on line %s. This event does not trigger any command."
msgstr "Fehler in Zeile %s. Dieses Ereignis löst keinen Befehl aus."

#: core/scenario.py:60
#, python-format
msgid "Scenario error: line %(line)s is not formatted as H:MM:SS;plugin;command (%(text)s)"
msgstr "Szenariofehler: Zeile %(line)s hat nicht das Format H:MM:SS;Plugin;Befehl (%(text)s)"

#: core/scenario.py:203 core/scenario.py:219
#, python-format
msgid "Error on line %(line)s. Invalid system command: %(command)s"
msgstr "Fehler in Zeile %(line)s. Ungültiger Systembefehl: %(command)s"

#: core/scenario.py:230
#, python-format
msgid "Error on line %s. Maximum length of an event is 2 (parameter;value)."
msgstr "Fehler in Zeile %s. Ein Ereignis hat höchstens 2 Elemente (Parameter;Wert)."

#: core/scenario.py:178
#, python-format
msgid "The (%s) plugin does not have a stop command."
msgstr "Das Plugin (%s) hat keinen stop-Befehl."

#: core/scenario.py:207
#, python-format
msgid "Error on line %s. Agent command requires a name argument"
msgstr "Fehler in Zeile %s. Der Befehl agent benötigt einen Namen als Argument"

#: core/scenario.py:194
#, python-format
msgid "The (%s) plugin has a start command without a preceding filename command."
msgstr "Das Plugin (%s) hat einen start-Befehl ohne vorangehenden filename-Befehl."

#: core/scenario.py:211
#, python-format
msgid "Error on line %(line)s. Unknown agent: %(agent)s"
msgstr "Fehler in Zeile %(line)s. Unbekannter Agent: %(agent)s"

#: core/scenario.py:237
#, python-format
msgid "Error on line %(line)s. Method (%(method)s) is not available for the plugin (%(plugin)s)"
msgstr "Fehler in Zeile %(line)s. Die Methode (%(method)s) ist für das Plugin (%(plugin)s) nicht verfügbar"

#: core/scenario.py:216
#, python-format
msgid "Error on line %s. mousecontrol command requires True/False argument"
msgstr "Fehler in Zeile %s. Der Befehl mousecontrol benötigt das Argument True/False"

#: core/scenario.py:288
#, python-format
msgid "Error on line %(line)s. The %(plugin)s plugin does not have a %(parameter)s parameter"
msgstr "Fehler in Zeile %(line)s. Das Plugin %(plugin)s hat keinen Parameter %(parameter)s"

#: core/scenario.py:258
#, python-format
msgid "Warning on line %(line)s. Parameter (%(parameter)s) has no verification method"
msgstr "Warnung in Zeile %(line)s. Der Parameter (%(parameter)s) hat keine Prüfmethode"

#: core/scenario.py:277
#, python-format
msgid "Error on line %(line)s. %(parameter)s "
msgstr "Fehler in Zeile %(line)s. %(parameter)s "

