#: core/utils.py:113
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a boolean (true or false, not %(value)s). Defaulting to False"
msgstr "In config.ini muss der Parameter [%(key)s] ein Boolean sein (true oder false, nicht %(value)s). Standardwert: False"

#: core/utils.py:127
#, python-format
msgid "In config.ini, [%(key)s] parameter must be an integer (not %(value)s)"
msgstr "In config.ini muss der Parameter [%(key)s] eine ganze Zahl sein (nicht %(value)s)"

#: core/utils.py:139
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a float (not %(value)s)"
msgstr "In config.ini muss der Parameter [%(key)s] eine Dezimalzahl sein (nicht %(value)s)"

#: core/utils.py:150
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a list of floats (not %(value)s)"
msgstr "In config.ini muss der Parameter [%(key)s] eine Liste von Dezimalzahlen sein (nicht %(value)s)"

#: core/utils.py:163
msgid "In config.ini, the specified font is not available. A default font will be used."
msgstr "Die in config.ini angegebene Schriftart ist nicht verfügbar. Eine Standardschrift wird verwendet."

#: core/validation.py:35
#, python-format
msgid "should be a natural (0 included) integer (not %s)."
msgstr "sollte eine natürliche Zahl sein (0 eingeschlossen) (nicht %s)."

#: core/validation.py:96
#, python-format
msgid "should be a positive float (not %s)"
msgstr "sollte eine positive Dezimalzahl sein (nicht %s)"

#: core/validation.py:221
#, python-format
msgid "should be a float between 0 and 1 (included) (not %s)"
msgstr "sollte eine Dezimalzahl zwischen 0 und 1 (eingeschlossen) sein (nicht %s)"

#: core/validation.py:169 core/validation.py:165
#, python-format
msgid "should be an acceptable joystick key value (not %s). See documentation."
msgstr "sollte eine gültige Joystick-Taste sein (nicht %s). Siehe Dokumentation."

#: core/validation.py:181
#, python-format
msgid "should be an acceptable (keyboard or joystick) key value (not %s). See documentation."
msgstr "sollte eine gültige Taste (Tastatur oder Joystick) sein (nicht %s). Siehe Dokumentation."

#: core/validation.py:31
#, python-format
msgid "should be a string (not %s)."
msgstr "sollte eine Zeichenkette sein (nicht %s)."

#: core/validation.py:52
#, python-format
msgid "should be a positive (0 excluded) integer (not %s)."
msgstr "sollte eine positive ganze Zahl sein (0 ausgeschlossen) (nicht %s)."

#: core/validation.py:129
#, python-format
msgid "should be comprised in %(accepted)s (not %(value)s)"
msgstr "sollte in %(accepted)s enthalten sein (nicht %(value)s)"

#: core/validation.py:149
#, python-format
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "sollte eine gültige Tastaturtaste sein (nicht %s). Siehe Dokumentation."

#: core/validation.py:199
#, python-format
msgid "should be composed of letters [a-z] or digits [0-9] (not %(characters)s in %(value)s)"
msgstr "sollte aus Buchstaben [a-z] oder Ziffern [0-9] bestehen (nicht %(characters)s in %(value)s)"

#: core/validation.py:217
#, python-format
msgid "should be composed of valid callsigns (not %s)"
msgstr "sollte aus gültigen Rufzeichen bestehen (nicht %s)"

#: core/validation.py:240
#, python-format
msgid "should be available either in the Instruction or Questionnaire folder (not %s)"
msgstr "sollte im Ordner Instruction oder Questionnaire vorhanden sein (nicht %s)"

#: core/validation.py:61
#, python-format
msgid "should be a boolean (not %s)."
msgstr "sollte ein Boolean sein (nicht %s)."

#: core/validation.py:139
#, python-format
msgid "should be a valid regex expression (not %s)"
msgstr "sollte ein gültiger regulärer Ausdruck (Regex) sein (nicht %s)"

#: core/validation.py:78
#, python-format
msgid "must be a color name (%(colors)s), (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %(value)s)"
msgstr "muss ein Farbname (%(colors)s), ein (R,G,B,a)- oder Hexadezimalwert sein (z. B. #00ff00) (nicht %(value)s)"

#: core/validation.py:91
#, python-format
msgid "should be (R,G,B,a) values each comprised between 0 and 255 (not %s)"
msgstr "sollten (R,G,B,a)-Werte jeweils zwischen 0 und 255 sein (nicht %s)"

