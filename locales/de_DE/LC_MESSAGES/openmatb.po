#: core/utils.py:113
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a boolean (true or false, not %(value)s). Defaulting to False"
msgstr "In config.ini muss der Parameter [%(key)s] ein Boolean sein (true oder false, nicht %(value)s). Standardwert: False"

#: core/utils.py:127
#, python-format
msgid "In config.ini, [%(key)s] parameter must be an integer (not %(value)s)"
msgstr "In config.ini muss der Parameter [%(key)s] eine ganze Zahl sein (nicht %(value)s)"

