#, python-format
msgid "In config.ini, [%(key)s] parameter must be a boolean (true or false, not %(value)s). Defaulting to False"
msgstr "En config.ini, el parámetro [%(key)s] debe ser un booleano (true o false, no %(value)s). Valor por defecto: False"

#: core/utils.py:127
#, python-format
msgid "In config.ini, [%(key)s] parameter must be an integer (not %(value)s)"
msgstr "En config.ini, el parámetro [%(key)s] debe ser un entero (no %(value)s)"

#: core/utils.py:139
#, python-format
