msgstr "En config.ini, el parámetro [%(key)s] debe ser una lista de números decimales (no %(value)s)"

#: core/utils.py:163
msgid "In config.ini, the specified font is not available. A default font will be used."
msgstr "En config.ini, la fuente indicada no está disponible. Se usará una fuente por defecto."

#: core/validation.py:35
#, python-format
msgid "should be a natural (0 included) integer (not %s)."
msgstr "debería ser un entero natural (0 incluido) (no %s)."

#: core/validation.py:96
#, python-format
msgid "should be a positive float (not %s)"
msgstr "debería ser un número decimal positivo (no %s)"

#: core/validation.py:221
#, python-format
msgid "should be a float between 0 and 1 (included) (not %s)"
msgstr "debería ser un número decimal entre 0 y 1 (incluidos) (no %s)"

#: core/validation.py:169 core/validation.py:165
#, python-format
msgid "should be an acceptable joystick key value (not %s). See documentation."
msgstr "debería ser una tecla de joystick válida (no %s). Consultá la documentación."

#: core/validation.py:181
#, python-format
msgid "should be an acceptable (keyboard or joystick) key value (not %s). See documentation."
msgstr "debería ser una tecla (de teclado o joystick) válida (no %s). Consultá la documentación."

#: core/validation.py:31
#, python-format
msgid "should be a string (not %s)."
msgstr "debería ser una cadena de caracteres (no %s)."

#: core/validation.py:52
#, python-format
msgid "should be a positive (0 excluded) integer (not %s)."
msgstr "debería ser un entero positivo (0 excluido) (no %s)."

#: core/validation.py:129
#, python-format
msgid "should be comprised in %(accepted)s (not %(value)s)"
msgstr "debería estar comprendido en %(accepted)s (no %(value)s)"

#: core/validation.py:149
#, python-format
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "debería ser una tecla de teclado válida (no %s). Consultá la documentación."

#: core/validation.py:199
#, python-format
msgid "should be composed of letters [a-z] or digits [0-9] (not %(characters)s in %(value)s)"
msgstr "debería estar compuesto de letras [a-z] o dígitos [0-9] (no %(characters)s en %(value)s)"

#: core/validation.py:217
#, python-format
msgid "should be composed of valid callsigns (not %s)"
msgstr "debería estar compuesto de indicativos válidos (no %s)"

#: core/validation.py:240
#, python-format
msgid "should be available either in the Instruction or Questionnaire folder (not %s)"
msgstr "debería estar en la carpeta Instruction o Questionnaire (no %s)"

#: core/validation.py:61
#, python-format
msgid "should be a boolean (not %s)."
msgstr "debería ser un booleano (no %s)."

#: core/validation.py:139
#, python-format
msgid "should be a valid regex expression (not %s)"
msgstr "debería ser una expresión regular (regex) válida (no %s)"

#: core/validation.py:78
#, python-format
msgid "must be a color name (%(colors)s), (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %(value)s)"
msgstr "debe ser un nombre de color (%(colors)s), un valor (R,G,B,a) o hexadecimal (p. ej., #00ff00) (no %(value)s)"

#: core/validation.py:91
#, python-format
msgid "should be (R,G,B,a) values each comprised between 0 and 255 (not %s)"
msgstr "deberían ser valores (R,G,B,a) comprendidos cada uno entre 0 y 255 (no %s)"

