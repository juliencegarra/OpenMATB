#: core/utils.py:113
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a boolean (true or false, not %(value)s). Defaulting to False"
msgstr "No config.ini, o parâmetro [%(key)s] deve ser um booleano (true ou false, não %(value)s). Valor padrão: False"

#: core/utils.py:127
#, python-format
msgid "In config.ini, [%(key)s] parameter must be an integer (not %(value)s)"
msgstr "No config.ini, o parâmetro [%(key)s] deve ser um número inteiro (não %(value)s)"

#: core/utils.py:139
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a float (not %(value)s)"
msgstr "No config.ini, o parâmetro [%(key)s] deve ser um número decimal (não %(value)s)"

#: core/utils.py:150
#, python-format
msgid "In config.ini, [%(key)s] parameter must be a list of floats (not %(value)s)"
msgstr "No config.ini, o parâmetro [%(key)s] deve ser uma lista de números decimais (não %(value)s)"

#: core/utils.py:163
msgid "In config.ini, the specified font is not available. A default font will be used."
msgstr "No config.ini, a fonte indicada não está disponível. Uma fonte padrão será usada."

#: core/validation.py:35
#, python-format
msgid "should be a natural (0 included) integer (not %s)."
msgstr "deve ser um número inteiro natural (0 incluído) (não %s)."

#: core/validation.py:96
#, python-format
msgid "should be a positive float (not %s)"
msgstr "deve ser um número decimal positivo (não %s)"

#: core/validation.py:221
#, python-format
msgid "should be a float between 0 and 1 (included) (not %s)"
msgstr "deve ser um número decimal entre 0 e 1 (incluídos) (não %s)"

#: core/validation.py:169 core/validation.py:165
#, python-format
msgid "should be an acceptable joystick key value (not %s). See documentation."
msgstr "deve ser uma tecla de joystick aceitável (não %s). Veja a documentação."

#: core/validation.py:181
#, python-format
msgid "should be an acceptable (keyboard or joystick) key value (not %s). See documentation."
msgstr "deve ser uma tecla (de teclado ou joystick) aceitável (não %s). Veja a documentação."

#: core/validation.py:31
#, python-format
msgid "should be a string (not %s)."
msgstr "deve ser um texto (não %s)."

#: core/validation.py:52
#, python-format
msgid "should be a positive (0 excluded) integer (not %s)."
msgstr "deve ser um número inteiro positivo (0 excluído) (não %s)."

#: core/validation.py:129
#, python-format
msgid "should be comprised in %(accepted)s (not %(value)s)"
msgstr "deve estar entre %(accepted)s (não %(value)s)"

#: core/validation.py:149
#, python-format
msgid "should be an acceptable keyboard key value (not %s). See documentation."
msgstr "deve ser uma tecla de teclado aceitável (não %s). Veja a documentação."

#: core/validation.py:199
#, python-format
msgid "should be composed of letters [a-z] or digits [0-9] (not %(characters)s in %(value)s)"
msgstr "deve ser composto de letras [a-z] ou dígitos [0-9] (não %(characters)s em %(value)s)"

#: core/validation.py:217
#, python-format
msgid "should be composed of valid callsigns (not %s)"
msgstr "deve ser composto de indicativos válidos (não %s)"

#: core/validation.py:240
#, python-format
msgid "should be available either in the Instruction or Questionnaire folder (not %s)"
msgstr "deve estar disponível na pasta Instruction ou Questionnaire (não %s)"

#: core/validation.py:61
#, python-format
msgid "should be a boolean (not %s)."
msgstr "deve ser um booleano (não %s)."

#: core/validation.py:139
#, python-format
msgid "should be a valid regex expression (not %s)"
msgstr "deve ser uma expressão regular (regex) válida (não %s)"

#: core/validation.py:78
#, python-format
msgid "must be a color name (%(colors)s), (R,G,B,a) or hexadecimal (e.g., #00ff00) values (not %(value)s)"
msgstr "deve ser um nome de cor (%(colors)s), valores (R,G,B,a) ou hexadecimal (ex.: #00ff00) (não %(value)s)"

#: core/validation.py:91
#, python-format
msgid "should be (R,G,B,a) values each comprised between 0 and 255 (not %s)"
msgstr "devem ser valores (R,G,B,a), cada um entre 0 e 255 (não %s)"

