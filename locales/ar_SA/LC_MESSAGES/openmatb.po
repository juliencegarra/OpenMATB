msgstr "خطأ في السطر %s. يتطلب الأمر mousecontrol الوسيط True/False"

#: core/scenario.py:288
#, python-format
msgid "Error on line %(line)s. The %(plugin)s plugin does not have a %(parameter)s parameter"
msgstr "خطأ في السطر %(line)s. الإضافة %(plugin)s لا تحتوي على المعامل %(parameter)s"

#: core/scenario.py:258
#, python-format
