msgstr "خطأ في السطر %s. الطريقة (%s) غير متاحة للإضافة (%s)"

#: core/scenario.py:206
msgid "Error on line %s. mousecontrol command requires True/False argument"
msgstr "خطأ في السطر %s. يتطلب الأمر mousecontrol الوسيط True/False"

#: core/scenario.py:271
