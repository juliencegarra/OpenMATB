msgstr "جاهز"

#: web/texts.json:45
msgid "Loading failed:"
msgstr "فشل التحميل:"

#: web/texts.json:46
msgid "The Firefox browser cannot guarantee the timing accuracy of the results, prefer Chrome or Edge."
msgstr "لا يضمن متصفح Firefox دقة توقيت النتائج، يُفضَّل استخدام Chrome أو Edge."

#: web/texts.json:47
msgid "This experiment requires Chrome or Edge: Firefox pauses for 0.1 to 1 s every few seconds, which makes timing unreliable."
msgstr "تتطلب هذه التجربة Chrome أو Edge: يتوقف Firefox من 0.1 إلى 1 ثانية كل بضع ثوانٍ، مما يجعل قياس الوقت غير موثوق."

#: web/texts.json:48
msgid "Slow loading"
msgstr "تحميل بطيء"

#: web/texts.json:49
msgid "The server does not send the .wasm files as application/wasm (Moodle: Site administration > Server > File types)."
msgstr "لا يرسل الخادم ملفات .wasm بالنوع application/wasm (Moodle: إدارة الموقع > الخادم > أنواع الملفات)."

#: web/texts.json:50
msgid "Trigger box (parallelport plugin)"
msgstr "صندوق المشغّلات (الإضافة parallelport)"

#: web/texts.json:51
msgid "No port chosen."
msgstr "لم يتم اختيار منفذ."

#: web/texts.json:52
msgid "Choose the port"
msgstr "اختر المنفذ"

#: web/texts.json:53
msgid "web_serial_trigger: this browser cannot use serial ports (use Chrome or Edge)"
msgstr "web_serial_trigger: لا يستطيع هذا المتصفح استخدام المنافذ التسلسلية (استخدم Chrome أو Edge)"

#: web/texts.json:54
msgid "Choose the port of the trigger box"
msgstr "اختر منفذ صندوق المشغّلات"

