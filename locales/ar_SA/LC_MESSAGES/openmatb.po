msgstr "خطأ في السطر %s. الإضافة %s لا تحتوي على المعامل %s"

#: core/scenario.py:245
msgid "Warning on line %s. Parameter (%s) has no verification method"
msgstr "تحذير في السطر %s. المعامل (%s) ليس له طريقة تحقق"

